node_modules
dist
.DS_Store

# Environment files (keep examples only)
.env
.env.local

# `yarn dev:local` keeps this instance identity here — it unwraps every credential.
.aflow-local/
.env.development
.env.*.local
!.env.example
mcp.local.json

coverage
.turbo
*.log
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Next.js build output
.next/
# Every Next output directory, not only the two names that existed first. A
# second dev server needs its own `distDir` to avoid colliding with the first,
# and an unignored one lands in the working tree as thousands of untracked
# files — which lint-staged then stashes, and a failed restore takes real edits
# with it. The same widening as `.dockerignore`, for the same reason.
.next-*/
# Regenerated by next dev vs next build (import path flips); not meaningful to version.
# Every Next application, not one of them: a tracked copy records whichever ran
# last, and the cloud-consumer proof reads that churn as the core being patched.
apps/*/next-env.d.ts

# TypeScript incremental build info
*.tsbuildinfo

# Debug output (run bundles, payloads)
.debug/
.vercel

# ESLint cache
.eslintcache

# Claude Code worktrees
.claude/worktrees/

# Codex local environment config
.codex/


# others
l2c/

# Local MCP credentials (AFLOW_MCP_LOCAL_AUTH_JSON)
mcp.local.json
auth.mcp.json

tmp/*
.claude/scheduled_tasks.lock

# Agent scratch: probes and throwaway scripts, never repo content.
.scratch/
