# =============================================================================
# Aflow Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Legend:
# - "Local default" = safe starter value for local dev
# - "Generate locally" = each developer should create their own value
# - "Get from platform/admin" = shared app/account config, distributed securely
# - "Personal key" = each developer should ideally use their own provider key
# =============================================================================

# =============================================================================
# LOCAL DEFAULTS
# =============================================================================

# Core infrastructure (local Docker defaults)
# Format: postgres://user:password@host:port/database
# Docker maps Postgres to port 5433 by default.
DATABASE_URL=postgres://phoenix:phoenix@localhost:5433/phoenix
REDIS_URL=redis://localhost:6379
# Managed Redis (e.g. Memorystore) requires AUTH. Kept separate from the URL
# so the URL stays an ordinary env var and only this is a secret.
# REDIS_PASSWORD=
# Skip TLS certificate verification for rediss:// URLs. Only for providers that
# present an untrusted chain — it makes the
# connection interceptable, so set it deliberately or not at all.
# REDIS_TLS_INSECURE=true

# Optional DB pool tuning for visibility / troubleshooting
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=10000
DB_SSL=false

# Server / app URLs
HOST=0.0.0.0
PORT=3000
MCP_PORT=3100
# Dev-only: path to JSON with apiKey (phx_...) or accessToken — skips MCP device login locally.
# Ignored when NODE_ENV=production. See apps/aflow-mcp/mcp.local.json.example
# AFLOW_MCP_LOCAL_AUTH_JSON=mcp.local.json
# Do not set NODE_ENV here — Next.js / Node manage it (`next dev` → development,
# `next build` → production). Setting NODE_ENV=development in .env breaks
# `next build` (prerender of /_global-error fails with useContext null).
# Pino: debug is very chatty (SSE, DB list, etc.). Use info for quieter dev logs.
LOG_LEVEL=info
# PERF slow-warning thresholds. Defaults are 1000ms / 1500ms in development
# and 100ms / 350ms in production. PERF_SLOW_READ_MS is allowed delay beyond
# the requested Redis BLOCK timeout; delivered-message age warnings stay on.
# PERF_SLOW_QUERY_MS=1000
# PERF_SLOW_READ_MS=1500
# Opt in to periodic workflow-sweeper and realtime surface-refresh summaries.
# Useful for identifying otherwise invisible background work; off by default.
# BACKGROUND_WORK_VERBOSE_LOGS=1
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3001
CORS_ORIGIN=true

# The tenant the browser names; `yarn start` sets it from the local instance.
# NEXT_PUBLIC_TENANT_ID=
# Fallback tenant for a multi-tenant deployment; the local edition pins its own.
# DEFAULT_TENANT_ID=

# Dev-only mock mode (normally leave false)
# Set to true to run without local DB / Redis.
USE_MOCK_CONTEXT=false

# Dev-only: allow editing system (platform) agents via the API.
# Set to any truthy value to bypass the read-only guard on seeded agents.
# ALLOW_SYSTEM_AGENT_EDIT=true

# Executors
EXECUTOR_CONCURRENCY=2
DEFAULT_TIMEOUT_MS=120000
# Agent turns use a progress-aware timeout: a stream delivering chunks is never
# reaped on elapsed time. Idle window = max silent gap before the stream counts
# as hung; ceiling = absolute cap even with continuous progress.
# AI_STREAM_IDLE_TIMEOUT_MS=120000
# AI_AGENT_TURN_MAX_TIMEOUT_MS=1200000
# HOSTNAME=
# ORCHESTRATOR_CONSUMER_NAME=orchestrator-1

# Observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# ENABLE_CONSOLE_TRACING=false

# Sentry (error monitoring, tracing, profiling). Off while SENTRY_DSN is unset, and
# in any build without @aflow/crash-reporter-sentry, which the public core omits.
# When active, Sentry OWNS OpenTelemetry, so OTEL_EXPORTER_OTLP_ENDPOINT is ignored.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=development           # defaults to NODE_ENV
# SENTRY_TRACES_SAMPLE_RATE=0.1            # server default 0.1, workers 0.05
# SENTRY_PROFILES_SAMPLE_RATE=0.2          # relative to sampled traces
# SENTRY_RELEASE=                          # set from git SHA in CI
# SENTRY_DEBUG=0                           # 1 = verbose SDK logging
# The web app reads its own DSN from NEXT_PUBLIC_SENTRY_DSN.

# =============================================================================
# AUTHENTICATION
# =============================================================================


# Development token secret, read only when no identity provider is configured.
# Unset gives a random per-process secret, so a value published here verifies nothing.
# JWT_SECRET=

# Fail a route that declares neither config.authz nor config.public nor
# config.authzExempt. On by default; 'false' downgrades to a warning and is
# ignored in production.
# AUTHZ_STRICT_ROUTE_VALIDATION=false

# =============================================================================
# AI PROVIDERS
# =============================================================================

# At least one AI provider key is required for non-mock AI flows.
# Prefer personal/sandbox keys per developer where possible.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
XAI_API_KEY=

# Optional provider endpoints / alternates
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_NEXT_GEN_API_BASE_URL=https://generativelanguage.googleapis.com
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# OPENAI_API_VERSION=2024-02-01

# =============================================================================
# SEARCH PROVIDERS
# =============================================================================

# Brave Search API key (free tier: 2000 queries/month)
# Get from: https://brave.com/search/api/
# Required for real web search. If not set, search steps will not be consumed
# (use mock executor in dev:core profile for testing without a key).
BRAVE_SEARCH_API_KEY=

# Jina Reader API key (optional — free tier works without a key)
# Get from: https://jina.ai/reader/
# Provides higher rate limits for web page fetching (search.web.fetch).
JINA_API_KEY=

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================

# Email delivery is off by default for local dev.
EMAIL_ENABLED=false

# Preferred naming in code is EMAIL_ENABLED plus SES_* SMTP settings.
# Get SMTP credentials from the platform/admin if you need to test email sending.
SES_SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_SECURE=false
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
SES_FROM_ADDRESS=assistant@aflow.ai
SES_FROM_NAME=Aflow
# SES_REPLY_TO=no-reply@aflow.ai
# SES_CONFIGURATION_SET=my-first-configuration-set
SES_MAX_SUBJECT_LENGTH=200
SES_MAX_CONTENT_BYTES=100000

# =============================================================================
# CLOUDFLARE ORIGIN VERIFICATION
# =============================================================================

# Shared secret for a Cloudflare WAF skip rule. When the API is proxied
# through Cloudflare, server-to-server callers (such as the web BFF) must
# send this header to bypass bot challenges. Not needed for local dev.
# Generate: openssl rand -hex 32
# CF_ORIGIN_SECRET=


# =============================================================================
# PRODUCTION-ONLY / CLOUD CONFIG
# =============================================================================

# Not required for normal local dev. Local payloads can stay inline / Redis-backed.
# Enable these when testing or running a GCP-backed environment.
# CREDENTIAL_ENCRYPTION_KEY=  # 32-byte base64; required in prod (Secret Manager on GCP)
# Move credential wrapping into Cloud KMS. Set to a crypto-key resource name
# (projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>) and the master key
# below is used only to read values written before the move — drop it once
# nothing reports needing a rewrap.
# CREDENTIAL_KMS_KEY=
# Retired keys that may still appear in stored credentials, comma-separated.
# Set during a rotation so old values keep decrypting while they are rewrapped;
# remove once nothing reports needing a rewrap.
# CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
# Where payloads live, most durable first. A named directory wins outright: it
# is an operator saying where payloads go, and the Redis fallback expires a
# non-persistent payload after 24 hours, which is a cache for development and
# data loss for anything whose database rows reference those payloads.
# PHOENIX_PAYLOAD_DIR=/var/lib/aflow/payloads
# Which composition root the server serves. The image sets this — a hosted
# distribution points it at the root composing its own surfaces — and an
# appliance leaves it alone. Listed so the key is classified, not so it is set.
# PHOENIX_SERVER_ENTRY=apps/server/dist/index.js
# GCS_PAYLOAD_BUCKET=phoenix-payloads
# GCP_PROJECT_ID=your-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# FEATURE_STREAMING_AI=true
# FEATURE_TOOL_CALLING=true

# ---------------------------------------------------------------------------
# Coding lane (apps/aflow-executor-code)
# ---------------------------------------------------------------------------
# Repo bindings and model-backend credentials are space-scoped DATABASE records,
# not env vars. Without DATABASE_URL the executor runs in mock mode and coding
# runs report success without touching any repository.

# The lane breaker. Unset means OFF, and so does any value other than
# 1/true/on/yes — this lane runs a credential-bearing agent with network egress,
# so ambiguity resolves to off. Set it on EVERY host that dispatches or executes
# code steps: the orchestrator refuses to enqueue a code job without it, and the
# code executor refuses to start. Per-space consent (spaces.code_policy) is a
# separate, additional switch.
# CODE_LANE_ENABLED=true

# Background Coach review after a terminal run. Off unless set to exactly "1":
# a run that raises a review nobody asked for produced 33,383 steps from a
# three-message chat. In production this is read from instance metadata
# (phoenix-coach-auto-review-enabled) by scripts/gcp-worker.sh.
# COACH_AUTO_REVIEW_ENABLED=1


# Origins a model credential may point at, beyond the ones its provider
# publishes — a corporate gateway or a self-hosted Anthropic-compatible proxy.
# Comma-separated origins (scheme + host + port, no path). Operator
# configuration on purpose: credential config is writable without re-entering
# the secret, so the destination is not a credential writer's to choose.
# CREDENTIAL_EXTRA_BASE_URL_ORIGINS=https://gateway.corp.internal
