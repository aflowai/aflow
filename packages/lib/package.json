{
  "name": "@aflow/lib",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/aflowai/aflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aflowai/aflow.git"
  },
  "bugs": {
    "url": "https://github.com/aflowai/aflow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "ts-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./service-bundle-path": {
      "ts-source": "./src/serviceBundlePath.ts",
      "types": "./dist/serviceBundlePath.d.ts",
      "import": "./dist/serviceBundlePath.js",
      "require": "./dist/serviceBundlePath.cjs"
    },
    "./appliance-bundle": {
      "ts-source": "./src/applianceBundle.ts",
      "types": "./dist/applianceBundle.d.ts",
      "import": "./dist/applianceBundle.js",
      "require": "./dist/applianceBundle.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx tsup src/index.ts src/serviceBundlePath.ts src/applianceBundle.ts --format esm,cjs && rm -f tsconfig.tsbuildinfo && npx tsc --emitDeclarationOnly",
    "dev": "npx tsup src/index.ts src/serviceBundlePath.ts --format esm,cjs --watch",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "fast-json-patch": "^3.1.1"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
