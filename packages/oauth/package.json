{
  "name": "@aflow/oauth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "ts-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx tsup src/index.ts --format esm,cjs && rm -f tsconfig.tsbuildinfo && npx tsc --emitDeclarationOnly",
    "dev": "npx tsup src/index.ts --format esm,cjs --watch",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aflow/database": "workspace:*",
    "@aflow/network-safety": "workspace:*",
    "@aflow/schemas": "workspace:*",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
