{
  "name": "@aflow/redis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "ts-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "ts-source": "./src/testing/stackRedis.ts",
      "types": "./dist/testing/stackRedis.d.ts",
      "import": "./dist/testing/stackRedis.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx tsup && rm -f tsconfig.tsbuildinfo && npx tsc --emitDeclarationOnly",
    "dev": "npx tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aflow/schemas": "workspace:*",
    "dotenv": "^16.4.5",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8",
    "ioredis-mock": "^8.13.1",
    "vitest": "^4.1.11"
  }
}
