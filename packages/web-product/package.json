{
  "name": "@aflow/web-product",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "ts-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./compiler": {
      "ts-source": "./src/uiCompiler.ts",
      "types": "./dist/uiCompiler.d.ts",
      "import": "./dist/uiCompiler.js",
      "require": "./dist/uiCompiler.cjs"
    },
    "./next": {
      "ts-source": "./src/nextSecurity.ts",
      "types": "./dist/nextSecurity.d.ts",
      "import": "./dist/nextSecurity.js",
      "require": "./dist/nextSecurity.cjs"
    },
    "./ui": {
      "ts-source": "./src/ui/index.ts",
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/theme": {
      "ts-source": "./src/ui/providers/themeStorage.ts",
      "types": "./dist/ui/providers/themeStorage.d.ts",
      "import": "./dist/ui/providers/themeStorage.js"
    },
    "./ui/server": {
      "ts-source": "./src/ui/server.ts",
      "types": "./dist/ui/server.d.ts",
      "import": "./dist/ui/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && npx tsup && rm -f tsconfig.tsbuildinfo src/ui/tsconfig.tsbuildinfo && npx tsc -p tsconfig.json --emitDeclarationOnly && npx tsc -p src/ui/tsconfig.json --emitDeclarationOnly",
    "dev": "npx tsup --watch --silent",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@aflow/platform-artifacts": "workspace:*",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-devtools": "^5.104.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@aflow/applet-runtime": "workspace:*",
    "@aflow/design-system": "workspace:*",
    "@aflow/run-view": "workspace:*",
    "@aflow/schemas": "workspace:*",
    "@aflow/surface-engine": "workspace:*",
    "@xyflow/react": "^12.12.0",
    "dompurify": "^3.4.17",
    "elkjs": "^0.12.0",
    "esbuild": "^0.28.2",
    "livekit-client": "^2.22.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-devtools": "^5.104.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query-devtools": {
      "optional": true
    }
  }
}
