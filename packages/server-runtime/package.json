{
  "name": "@aflow/server-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "ts-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./bootstrap": {
      "ts-source": "./src/bootstrap/index.ts",
      "types": "./dist/bootstrap/index.d.ts",
      "import": "./dist/bootstrap/index.js",
      "require": "./dist/bootstrap/index.cjs"
    },
    "./fastify": {
      "ts-source": "./src/fastify.ts",
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js",
      "require": "./dist/fastify.cjs"
    },
    "./lib": {
      "ts-source": "./src/lib/index.ts",
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs"
    },
    "./routes": {
      "ts-source": "./src/routes/index.ts",
      "types": "./dist/routes/index.d.ts",
      "import": "./dist/routes/index.js",
      "require": "./dist/routes/index.cjs"
    },
    "./services": {
      "ts-source": "./src/services/index.ts",
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js",
      "require": "./dist/services/index.cjs"
    },
    "./testing": {
      "ts-source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx tsup src/index.ts src/fastify.ts src/bootstrap/index.ts src/lib/index.ts src/routes/index.ts src/services/index.ts src/testing/index.ts --format esm,cjs --external vitest && rm -f tsconfig.tsbuildinfo && npx tsc --emitDeclarationOnly",
    "dev": "npx tsup src/index.ts src/fastify.ts src/bootstrap/index.ts src/lib/index.ts src/routes/index.ts src/services/index.ts src/testing/index.ts --format esm,cjs --external vitest --watch",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aflow/ai-client": "workspace:*",
    "@aflow/applet-runtime": "workspace:*",
    "@aflow/authz": "workspace:*",
    "@aflow/credential-resolver": "workspace:*",
    "@aflow/cybernetic-runtime": "workspace:*",
    "@aflow/database": "workspace:*",
    "@aflow/integration-simulator": "workspace:*",
    "@aflow/lib": "workspace:*",
    "@aflow/memory-store": "workspace:*",
    "@aflow/network-safety": "workspace:*",
    "@aflow/oauth": "workspace:*",
    "@aflow/observability": "workspace:*",
    "@aflow/payload-store": "workspace:*",
    "@aflow/platform-artifacts": "workspace:*",
    "@aflow/redis": "workspace:*",
    "@aflow/run-view": "workspace:*",
    "@aflow/schemas": "workspace:*",
    "@aflow/ui-artifact-compiler": "workspace:*",
    "@fastify/cors": "^10.0.3",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/websocket": "^11.3.1",
    "@opentelemetry/api": "^1.9.1",
    "ajv": "^8.20.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.11.1",
    "jsonata": "^2.2.2",
    "postgres": "^3.4.9",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
