{
  "name": "@aflow/executor-runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "ts-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npx tsup && rm -f tsconfig.tsbuildinfo && npx tsc --emitDeclarationOnly",
    "dev": "npx tsup --watch",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aflow/input-resolution": "workspace:*",
    "@aflow/observability": "workspace:*",
    "@aflow/payload-store": "workspace:*",
    "@aflow/redis": "workspace:*",
    "@aflow/schemas": "workspace:*",
    "ioredis": "^5.11.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
