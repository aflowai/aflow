{
  "name": "phoenix",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "background-work:baseline": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx scripts/background-work-baseline.ts",
    "background-work:docs": "NODE_OPTIONS='--conditions=ts-source' npx tsx scripts/generate-background-work-docs.ts",
    "background-work:inventory": "NODE_OPTIONS='--conditions=ts-source' npx tsx scripts/background-work-inventory.ts",
    "bootstrap:local": "NODE_OPTIONS='--conditions=ts-source' yarn workspace @aflow/server bootstrap:local",
    "build": "yarn workspaces foreach -A --topological run build",
    "build:since": "yarn workspaces foreach --since -t run build",
    "catalog:export": "NODE_OPTIONS='--conditions=ts-source' npx tsx scripts/export-operation-catalog.ts",
    "check:packages": "node scripts/check-package-staleness.mjs",
    "clean": "yarn workspaces foreach -A run clean && rm -rf node_modules",
    "compute:build-ml": "docker build -t phoenix-python-ml:latest -f docker/Dockerfile.python-ml .",
    "context:baseline": "NODE_OPTIONS='--conditions=ts-source' npx tsx scripts/context-budget/cli.ts update-baseline",
    "context:check": "NODE_OPTIONS='--conditions=ts-source' npx tsx scripts/context-budget/cli.ts check",
    "context:scan": "NODE_OPTIONS='--conditions=ts-source' npx tsx scripts/context-budget/cli.ts scan",
    "db:migrate": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx scripts/release.mjs",
    "db:migrate-tenants": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- npx tsx scripts/migrate-tenants.ts",
    "db:seed": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx scripts/seed-flows.ts",
    "db:seed:cybernetic": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx scripts/dev/seed-cybernetic-space.ts",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "dev:core": "node scripts/dev.mjs --profile core",
    "dev:engine": "node scripts/dev.mjs --profile engine",
    "dev:local": "NODE_OPTIONS='--conditions=ts-source' npx tsx scripts/dev-local.ts",
    "dev:mcp": "node scripts/dev.mjs --profile mcp",
    "executor:ai": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx watch --include 'packages/*/src/**/*.ts' apps/aflow-executor-ai/src/index.ts",
    "executor:api": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx watch --include 'packages/*/src/**/*.ts' apps/aflow-executor-api/src/index.ts",
    "executor:compute": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx watch --include 'packages/*/src/**/*.ts' apps/aflow-executor-compute/src/index.ts",
    "executor:host": "NODE_OPTIONS='--conditions=ts-source' tsx watch --include 'packages/*/src/**/*.ts' apps/aflow-executor-host/src/index.ts",
    "executor:mcp": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx watch --include 'packages/*/src/**/*.ts' apps/aflow-executor-mcp/src/index.ts",
    "executor:memory": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx watch --include 'packages/*/src/**/*.ts' apps/aflow-executor-memory/src/index.ts",
    "executor:mock": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx watch --include 'packages/*/src/**/*.ts' apps/aflow-executor-mock/src/index.ts",
    "executor:ui": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx watch --include 'packages/*/src/**/*.ts' apps/aflow-executor-ui/src/index.ts",
    "executor:user": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx watch --include 'packages/*/src/**/*.ts' apps/aflow-executor-user/src/index.ts",
    "format": "./scripts/format.sh",
    "format:check": "prettier . --check",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "infra:tools": "docker compose --profile tools up -d",
    "infra:up": "docker compose up -d",
    "kill": "bash scripts/kill-dev.sh",
    "large-files:baseline": "NODE_OPTIONS='--conditions=ts-source' npx tsx scripts/large-files/cli.ts update-baseline",
    "large-files:check": "NODE_OPTIONS='--conditions=ts-source' npx tsx scripts/large-files/cli.ts check",
    "large-files:scan": "NODE_OPTIONS='--conditions=ts-source' npx tsx scripts/large-files/cli.ts scan",
    "lint": "node scripts/lint-workspaces.mjs",
    "lint:changed": "./scripts/lint-changed.sh",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --fix --cache",
    "lint:progress": "bash scripts/lint-progress.sh",
    "lint:staged": "npx lint-staged",
    "local:backup": "bash scripts/appliance-backup.sh",
    "local:bundle": "NODE_OPTIONS='--conditions=ts-source' npx tsx scripts/appliance-bundle.mjs",
    "local:dev:up": "bash scripts/appliance-dev.sh up",
    "local:dev:web": "bash scripts/appliance-dev.sh web",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "local:logs": "docker compose -f docker-compose.local.yml logs -f",
    "local:restore": "bash scripts/appliance-restore.sh",
    "local:smoke": "bash scripts/appliance-smoke.sh",
    "local:up": "docker compose -f docker-compose.local.yml up -d --build",
    "mcp:dev": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx watch --include 'packages/*/src/**/*.ts' apps/aflow-mcp/src/index.ts",
    "mcp:setup": "node scripts/mcp-local-setup.mjs",
    "models:verify-reasoning": "NODE_OPTIONS='--conditions=ts-source' npx tsx scripts/verify-reasoning-profiles.ts",
    "orchestrator:dev": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx watch --include 'packages/*/src/**/*.ts' apps/aflow-orchestrator/src/index.ts",
    "packages:watch": "yarn workspaces foreach -A --include '@aflow/schemas' --include '@aflow/redis' --include '@aflow/database' --include '@aflow/executor-runtime' --include '@aflow/payload-store' --include '@aflow/ai-client' --include '@aflow/input-resolution' --include '@aflow/observability' --include '@aflow/lib' -p run dev",
    "postinstall": "node scripts/postinstall.mjs",
    "preflight": "./scripts/preflight.sh",
    "preflight:no-test": "./scripts/preflight.sh --no-test",
    "server:dev": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx watch --include 'packages/*/src/**/*.ts' apps/server/src/index.ts",
    "server:start": "yarn workspace @aflow/server start",
    "space:nuke": "NODE_OPTIONS='--conditions=ts-source' dotenv -e .env -- tsx scripts/space-nuke.ts",
    "test": "node scripts/test-runner.mjs full",
    "test:changed": "node scripts/test-runner.mjs changed",
    "test:file": "node scripts/test-runner.mjs file",
    "test:flows": "./scripts/test-flows.sh",
    "test:flows:list": "./scripts/test-flows.sh --list",
    "test:profile": "node scripts/test-runner.mjs profile",
    "test:workspace": "node scripts/test-runner.mjs workspace",
    "typecheck": "tsc -b && npx tsc -p packages/schemas/tsconfig.guards.json && node scripts/check-lifecycle-exhaustive.mjs && NODE_OPTIONS='--conditions=ts-source' npx tsx scripts/large-files/cli.ts check && node scripts/lint-workspaces.mjs --assert-only && NODE_OPTIONS='--conditions=ts-source' npx tsx scripts/context-budget/cli.ts check",
    "web:routes": "node scripts/generate-web-routes.mjs",
    "third-party-notices": "node scripts/third-party-notices.mjs",
    "contracts:check": "node scripts/publishable-contracts.mjs --check"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --no-warn-ignored"
    ],
    "*.{ts,tsx,js,jsx,mjs,json,md,css}": [
      "prettier --write --list-different"
    ]
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.53.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@4.12.0",
  "resolutions": {
    "fast-jwt": "^6.2.4",
    "fast-uri": "3.1.7",
    "minimatch@npm:^9.0.4": "9.0.9",
    "minimatch@npm:^9.0.5": "9.0.9",
    "minimatch@npm:^10.1.1": "10.2.5",
    "brace-expansion@npm:^1.1.7": "1.1.21",
    "brace-expansion@npm:^2.0.2": "2.1.7",
    "brace-expansion@npm:^5.0.5": "5.0.12",
    "vite": "7.3.6",
    "picomatch@npm:^2.3.1": "2.3.2",
    "picomatch@npm:^4.0.2": "4.0.4",
    "picomatch@npm:^4.0.3": "4.0.4",
    "path-to-regexp": "8.4.2",
    "fast-xml-parser": "5.7.2",
    "lodash-es": "4.18.1",
    "protobufjs": "7.6.5",
    "ip-address": "10.5.0",
    "postcss": "8.5.25",
    "uuid": "14.0.0",
    "form-data@npm:^4.0.5": "4.0.6",
    "sharp": "0.35.4",
    "@fastify/static": "10.1.2",
    "@hono/node-server@npm:^1.19.9": "2.0.12",
    "ajv@npm:^6.12.4": "6.15.0",
    "ajv@npm:^8.0.0": "8.20.0",
    "ajv@npm:^8.12.0": "8.20.0",
    "ajv@npm:^8.17.1": "8.20.0",
    "hono": "^4.12.34",
    "@tootallnate/once": "3.0.1",
    "esbuild@npm:^0.19.7": "0.28.1",
    "esbuild@npm:^0.27.0": "0.28.1",
    "esbuild@npm:~0.27.0": "0.28.1",
    "esbuild@npm:^0.27.5": "0.28.1",
    "esbuild@npm:~0.18.20": "0.28.1",
    "@types/node": "22.20.4",
    "js-yaml@npm:^4.1.1": "4.3.2"
  },
  "dependencies": {
    "croner": "^10.0.1"
  }
}
