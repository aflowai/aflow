{
  "name": "@aflow/aflow-executor-mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "npx tsc",
    "dev": "NODE_OPTIONS='--conditions=ts-source' node ../../scripts/with-stack-env.mjs node ../../scripts/watch-service.mjs src/index.ts src ../../packages",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aflow/database": "workspace:*",
    "@aflow/executor-runtime": "workspace:*",
    "@aflow/lib": "workspace:*",
    "@aflow/network-safety": "workspace:*",
    "@aflow/oauth": "workspace:*",
    "@aflow/observability": "workspace:*",
    "@aflow/payload-store": "workspace:*",
    "@aflow/redis": "workspace:*",
    "@aflow/schemas": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.31.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
