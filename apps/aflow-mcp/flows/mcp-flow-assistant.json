{
  "flowId": "mcp-flow-assistant",
  "metadata": {
    "name": "MCP Flow Assistant",
    "description": "Flow and run management assistant for MCP-connected coding agents. Handles flow CRUD, validation, run execution, debugging.",
    "tags": ["mcp", "system"]
  },
  "stateVariables": [
    {
      "variableId": "result",
      "name": "Result",
      "typeSchema": {
        "type": "string"
      },
      "semanticType": "json",
      "lifecycle": {
        "isInput": false,
        "isOutput": true,
        "persistOnPause": true
      }
    },
    {
      "variableId": "prompt",
      "name": "Prompt",
      "typeSchema": {
        "type": "string"
      },
      "semanticType": "text",
      "lifecycle": {
        "isInput": true,
        "isOutput": false,
        "persistOnPause": true
      }
    }
  ],
  "steps": [
    {
      "stepId": "ai-1",
      "stepType": "ai",
      "operation": "ai.agent.turn",
      "name": "Assistant",
      "config": {
        "goal": "${state.prompt}",
        "model": "openai/gpt-oss-120b",
        "prompt": "${state.prompt}",
        "catalog": {
          "stepTypes": ["platform", "flow"]
        },
        "temperature": 0,
        "systemPrompt": "You are the Aflow Flow Specialist. You create, manage, and debug flows. When calling flow.control.run_step, pass operationId and wrap the operation-specific parameters in the `inputs` object. Understand the agent flow pattern: discover \u2192 agent \u2192 tool \u2192 agent (loop). Be concise."
      },
      "onSuccess": {
        "next": [
          {
            "stepId": "flow-1",
            "priority": 50
          }
        ]
      },
      "onFailure": {
        "next": [
          {
            "stepId": "ai-1",
            "priority": 50
          }
        ]
      }
    },
    {
      "stepId": "flow-1",
      "stepType": "flow",
      "operation": "flow.control.run_step",
      "name": "Run Step",
      "config": {
        "operationId": "${input.operationId}"
      },
      "outputMapping": {
        "result": "state.result"
      },
      "outputOptions": {
        "displayToUser": true
      },
      "tags": [],
      "onSuccess": {
        "next": [
          {
            "stepId": "ai-1",
            "priority": 50
          }
        ]
      },
      "onFailure": {
        "next": [
          {
            "stepId": "ai-1",
            "priority": 50
          }
        ]
      }
    }
  ],
  "startStepId": "ai-1",
  "supportedModes": ["chat", "mcp"]
}
