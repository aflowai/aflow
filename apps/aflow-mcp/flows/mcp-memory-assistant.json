{
  "flowId": "mcp-memory-assistant",
  "metadata": {
    "name": "MCP Memory Assistant",
    "description": "Specialized memory management assistant for MCP-connected coding agents. Full access to memory operations.",
    "tags": ["mcp", "system"]
  },
  "stateVariables": [
    {
      "variableId": "result",
      "name": "Result",
      "typeSchema": {
        "type": "string"
      },
      "semanticType": "json",
      "lifecycle": {
        "isInput": false,
        "isOutput": true,
        "persistOnPause": true
      }
    },
    {
      "variableId": "prompt",
      "name": "Prompt",
      "typeSchema": {
        "type": "string"
      },
      "semanticType": "text",
      "lifecycle": {
        "isInput": true,
        "isOutput": false,
        "persistOnPause": true
      }
    }
  ],
  "steps": [
    {
      "stepId": "ai-1",
      "stepType": "ai",
      "operation": "ai.agent.turn",
      "name": "Assistant",
      "config": {
        "goal": "${state.prompt}",
        "model": "openai/gpt-oss-120b",
        "prompt": "${state.prompt}",
        "catalog": {
          "stepTypes": ["memory"]
        },
        "temperature": 0,
        "systemPrompt": "You are the Aflow Memory Specialist. You manage documents in a space's memory store. Use the available tools to list, read, write, and search memory documents. When calling flow.control.run_step, pass operationId and wrap the operation-specific parameters in the `inputs` object. Be concise and action-oriented.",
        "turnPolicy": {
          "maxToolCallsPerTurn": 10,
          "allowParallel": false,
          "allowComplete": true
        }
      },
      "onSuccess": {
        "next": [
          {
            "stepId": "flow-1",
            "priority": 50
          }
        ]
      },
      "onFailure": {
        "next": [
          {
            "stepId": "ai-1",
            "priority": 50
          }
        ]
      }
    },
    {
      "stepId": "flow-1",
      "stepType": "flow",
      "operation": "flow.control.run_step",
      "name": "Run Step",
      "config": {
        "operationId": "${input.operationId}"
      },
      "outputMapping": {
        "result": "state.result"
      },
      "outputOptions": {
        "displayToUser": true
      },
      "tags": [],
      "onSuccess": {
        "next": [
          {
            "stepId": "ai-1",
            "priority": 50
          }
        ]
      },
      "onFailure": {
        "next": [
          {
            "stepId": "ai-1",
            "priority": 50
          }
        ]
      }
    }
  ],
  "startStepId": "ai-1",
  "supportedModes": ["chat", "mcp"]
}
