    "build": "npx tsc",
    "cli": "node scripts/cli.mjs",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aflow/executor-runtime": "workspace:*",
    "@aflow/lib": "workspace:*",
    "@aflow/network-safety": "workspace:*",
    "@aflow/payload-store": "workspace:*",
    "@aflow/redis": "workspace:*",
    "@aflow/schemas": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  }
}
