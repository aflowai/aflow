{
  "name": "@aflow/aflow-channel-slack",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "phoenix": {
    "shipsInImage": false,
    "shipsInImageReason": "An optional channel app (Plan 327): it runs beside the stack as the operator's own user, holds the Slack connection and keeps its records in a local store of its own. An install without it has no channel lane."
