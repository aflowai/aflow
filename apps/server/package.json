{
  "name": "@aflow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=ts-source' node ../../scripts/with-stack-env.mjs node ../../scripts/watch-service.mjs src/index.ts src ../../packages",
    "build": "npx tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests",
    "bootstrap:local": "PHOENIX_EDITION=community-local node ../../scripts/with-stack-env.mjs tsx src/bootstrapLocal.ts"
  },
  "dependencies": {
    "@aflow/database": "workspace:*",
    "@aflow/observability": "workspace:*",
    "@aflow/redis": "workspace:*",
    "@aflow/schemas": "workspace:*",
    "@aflow/server-runtime": "workspace:*",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
