{
  "name": "@aflow/web-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "dev": "rm -rf .next-dev && NEXT_DIST_DIR=.next-dev next dev --port ${WEB_DEV_PORT:-3002}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aflow/design-system": "workspace:*",
    "@aflow/web-product": "workspace:*",
    "@tanstack/react-query": "^5.103.2",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
