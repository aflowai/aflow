{
  "name": "@aflow/aflow-executor-compute",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "npx tsc",
    "dev": "NODE_OPTIONS='--conditions=ts-source' node ../../scripts/with-stack-env.mjs tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aflow/database": "workspace:*",
    "@aflow/executor-runtime": "workspace:*",
    "@aflow/lib": "workspace:*",
    "@aflow/memory-paths": "workspace:*",
    "@aflow/memory-store": "workspace:*",
    "@aflow/observability": "workspace:*",
    "@aflow/payload-store": "workspace:*",
    "@aflow/redis": "workspace:*",
    "@aflow/schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8",
    "@types/node": "^22.20.4",
    "ioredis-mock": "^8.13.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
